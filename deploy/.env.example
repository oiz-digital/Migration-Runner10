# ============================================================
# Zebvix — VPS Production Environment Variables
# Copy this file to .env and fill in all values before deploy.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://cryptox:StrongPassword123@localhost:5432/cryptox

# ── Session / Auth ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64_CHAR_HEX_SECRET

# ── Node ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Go Service ────────────────────────────────────────────────
GO_SERVICE_PORT=23004

# ── CORS / Domain ─────────────────────────────────────────────
ALLOWED_ORIGINS=https://zebvix.com,https://www.zebvix.com
REPLIT_DOMAINS=zebvix.com

# ── Redis (embedded by default — no external Redis needed) ────
# Only set if you want to use an external Redis instance
# REDIS_URL=redis://localhost:6379

# ── Email (configure via Admin Panel instead if possible) ─────
# These are only needed for bootstrap / fallback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@zebvix.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Zebvix <noreply@zebvix.com>

# ── Crypto / Blockchain ────────────────────────────────────────
# Hot wallet keys are stored encrypted in DB via admin panel.
# Do NOT put private keys here.

# ── KYC Provider ──────────────────────────────────────────────
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# ONFIDO_API_TOKEN=

# ── Payment Gateway ───────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=

# ── Push Notifications ────────────────────────────────────────
# FCM_SERVER_KEY=

# ── Sentry / Monitoring (optional) ────────────────────────────
# SENTRY_DSN=
