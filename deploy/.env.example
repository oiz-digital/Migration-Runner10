# =============================================================================
# Zebvix — Environment Variables Reference
# Copy to /opt/cryptox/.env and fill every value before starting services.
# =============================================================================

# ─── Core ────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (auto-generated by zebvix-setup.sh)
DATABASE_URL=postgresql://cryptox:CHANGE_ME@localhost:5432/cryptox

# Express session signing key — MUST be 64+ random hex chars
# Generate: openssl rand -hex 64
SESSION_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64

# Shared secret between Node API server and Go matching engine
# Generate: openssl rand -hex 32
INTERNAL_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# ─── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins (REQUIRED in production)
CORS_ORIGINS=https://zebvix.com,https://www.zebvix.com

# ─── Node Environment ────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080

# ─── KYC Uploads ─────────────────────────────────────────────────────────────

# Persistent upload directory for KYC documents — MUST survive reboots.
# Do NOT use /tmp — it is wiped on reboot.
KYC_UPLOAD_DIR=/var/lib/zebvix/kyc-uploads

# ─── Redis ───────────────────────────────────────────────────────────────────

# External Redis (recommended for production — persists watchlists + sessions).
# Install: sudo apt install redis-server && sudo systemctl enable redis-server
# If not set, api-server spawns in-process Redis (data lost on restart).
REDIS_URL=redis://127.0.0.1:6379

# ─── Email / OTP ─────────────────────────────────────────────────────────────

# SMTP (configure via Admin → API Integrations → Email after first boot)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.XXXXX
# SMTP_FROM=noreply@zebvix.com

# ─── SMS / WhatsApp OTP ──────────────────────────────────────────────────────

# NinzaSMS (configure via Admin → OTP Providers)
# NINZA_API_KEY=
# NINZA_SENDER=ZEBVIX

# ─── Hot Wallet ──────────────────────────────────────────────────────────────

# Vault password that encrypts private keys stored in DB. Never lose this.
# Generate: openssl rand -hex 32
# VAULT_PASSWORD=CHANGE_ME

# ─── Compliance / KYC ────────────────────────────────────────────────────────

# DigiLocker / Aadhaar API (configure via Admin → KYC Settings)
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=https://zebvix.com/api/kyc/digilocker/callback

# Onfido (optional — alternative KYC provider)
# ONFIDO_API_TOKEN=

# ─── Payment Gateways (INR on/off ramp) ──────────────────────────────────────

# Razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Cashfree
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=

# PayU
# PAYU_MERCHANT_KEY=
# PAYU_MERCHANT_SALT=

# ─── Push Notifications ──────────────────────────────────────────────────────

# Firebase Cloud Messaging (for mobile push alerts)
# FIREBASE_SERVER_KEY=
# FIREBASE_PROJECT_ID=

# ─── Object Storage (for KYC docs in multi-server setups) ────────────────────

# AWS S3 / compatible (Cloudflare R2, MinIO, etc.)
# S3_BUCKET=zebvix-kyc
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # leave blank for AWS; set for R2/MinIO

# ─── Go Service ──────────────────────────────────────────────────────────────
# These are set by pm2.config.cjs — only override here if not using PM2.
# PORT=23004
# BASE_PATH=/go-service/
# BIND_ADDR=127.0.0.1        # ALWAYS 127.0.0.1 in production

# ─── Advanced / Optional ─────────────────────────────────────────────────────

# Override Redis binary path (only if using in-process Redis)
# REDIS_SERVER_BIN=/usr/bin/redis-server

# Disable leader election for single-replica deployments
# LEADER_SINGLE_INSTANCE_FALLBACK=true

# Instance ID for multi-replica log correlation (auto-generated if not set)
# INSTANCE_ID=api-1

# Sentry error tracking
# SENTRY_DSN=
